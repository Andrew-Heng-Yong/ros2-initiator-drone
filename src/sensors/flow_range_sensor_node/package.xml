<?xml version="1.0"?>
<package format="3">
  <name>flow_range_sensor_node</name>
  <version>0.1.0</version>
  <description>Linux SPI/I2C ROS 2 driver for an ALIENTEK PMW3901 optical-flow and VL53L1X 4 m range module.</description>
  <maintainer email="user@example.com">Workspace maintainer</maintainer>
  <license>Apache-2.0</license>
  <license>BSD-3-Clause</license>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>rosidl_default_generators</build_depend>

  <depend>diagnostic_msgs</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>
  <export><build_type>ament_cmake</build_type></export>
</package>
